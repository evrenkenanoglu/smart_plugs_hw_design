# --- Altium Designer Gitignore ---

# 1. Automatic History & Backups (Crucial to ignore - these are huge)
History/
__Previews/
*.SchDocPreview
*.PcbDocPreview
*.HarnessPreview

# 2. Temporary & Lock Files
*.bck
*.lck
*.lock
*.drc
*.log
*.LOG
*.tlog
*.SchDoc.Lock
*.PcbDoc.Lock

# 3. Project Structure & Cache
*.PrjPcbStructure
*.PrjPCBStructure
*.UniqueIdCache

# 4. Compilation & Reports (Auto-generated junk)
Project Logs for */
*.htm
*.html
*.xml
*.rep
*.apr
*.apr_lib
*.EXTREP
*.REP

# 5. Output Files (Optional - See Note Below)
# Usually, you don't commit generated Gerbers/BOMs unless they are a specific "Release" zip.
# Altium auto-generates these folders every time you output job files.
Project Outputs for */
Status Report.Txt
Release*

# 6. Simulation & Signal Integrity
*.nsx
*.sim
*.sdf
*.cir

# 7. OS Specific
.DS_Store
Thumbs.db

# 8. Python
*.py[cod]
__pycache__/
.pytest_cache/
*.egg-info/
env/
venv/
.venv/
_SCRATCH/


.vscode/
out*/

temp/

# Keep generated, revision-tagged release packages visible to Git.
!/RELEASES/
!/RELEASES/**
!/ECAD/Smart_Plugs_EasyEDA/Releases/
!/ECAD/Smart_Plugs_EasyEDA/Releases/**

# Keep EasyEDA project backup files local; commit the active project only.
ECAD/Smart_Plugs_EasyEDA/Smart_Plugs_backup/
ECAD/Smart_Plugs_EasyEDA/Smart_Plugs.eprj_backup

# Keep generated EMC runs and calculation reports local.
EMC/openems/experiments/runs/
EMC/smart_power_strip/runs/
ANALYSIS/power_calculations/*/reports/generated/