{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        // Change the color theme to your preference
        "workbench.colorCustomizations": {
            "activityBar.background": "#6c6415",
            "titleBar.activeBackground": "#6c6415",
            "titleBar.activeForeground": "#f5ffde"
        },
        "python.terminal.activateEnvironment": true
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "espressif.esp-idf-extension"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "HW: Run Power Calculations",
                "type": "shell",
                "windows": {
                    "command": "Set-Location -LiteralPath \"${workspaceFolder}\\ANALYSIS\\power_calculations\\POWER_CALCULATIONS\\scripts\"; & \"${workspaceFolder}\\.venv\\Scripts\\python.exe\" main.py"
                },
            },
            {
                "label": "HW: Run Relay Transistor Calculations",
                "type": "shell",
                "windows": {
                    "command": "Set-Location -LiteralPath \"${workspaceFolder}\\ANALYSIS\\power_calculations\\RELAY_TRANSISTOR_CALCULATION\\scripts\"; & \"${workspaceFolder}\\.venv\\Scripts\\python.exe\" relay_transistor_report.py"
                },
            },
            {
                "label": "HW: Create Release PCB Gerber Package",
                "type": "shell",
                "windows": {
                    "command": "Set-Location -LiteralPath \"${workspaceFolder}\\PCB\\_archive\\Smart_Plugs\\Scripts\"; & \"${workspaceFolder}\\.venv\\Scripts\\python.exe\" package_gerbers.py"
                },
            }
        ]
    }
}